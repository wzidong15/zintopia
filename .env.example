# Copy to .env in the repo root (gitignored).
POLYGON_API_KEY=
# MASSIVE_API_KEY=   # alias; Polygon.io rebranded to Massive.com

# LLM investment suggestions (POST /api/llm-advice/{symbol} + /chat follow-ups)
# Set one or both; auto picks OpenAI first when both are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_MODEL=gpt-5.2   # example when available on your account

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL=claude-opus-4-20250514
# LLM_PROVIDER=openai|anthropic|auto

# Selected ticker price poll (seconds). Daily TA stays on-demand.
ZINTOPIA_LIVE_REFRESH_SEC=10
# Stock OHLCV charts, NAV chart, and portfolio performance (seconds).
ZINTOPIA_CHART_REFRESH_SEC=30
# Market news + ticker news poll (seconds). Override one feed if needed.
ZINTOPIA_NEWS_REFRESH_SEC=60
# ZINTOPIA_MARKET_NEWS_REFRESH_SEC=60
# ZINTOPIA_TICKER_NEWS_REFRESH_SEC=60

# Auto paper strategies: how often to try a step while ./start.sh is running (seconds).
ZINTOPIA_STRATEGY_INTERVAL_SEC=3600

# Paper funds + watchlist JSON (default ~/.zintopia). Keep this outside the git repo.
# ZINTOPIA_DATA_DIR=~/.zintopia
# Docker bind-mounts this host folder at /data (same funds as ./start.sh).
# ZINTOPIA_HOST_DATA_DIR=~/.zintopia

# Keep-alive pool for Polygon / TradingView / Stooq HTTP (default 20, clamp 2–128).
# ZINTOPIA_HTTP_POOL_SIZE=20
